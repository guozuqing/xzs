/**index.wxss**/

.index-page {
  padding-bottom: 20rpx;
}

/* 轮播 */
.index-banner {
  padding: 20rpx 24rpx 0;
}

.index-swiper {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 300rpx;
}

/* 快捷导航 */
.quick-nav {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 28rpx 16rpx;
}

.quick-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.nav-icon-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.quick-nav-label {
  font-size: 22rpx;
  color: #999;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-bar {
  width: 6rpx;
  height: 28rpx;
  background: #4A90E2;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.section-count {
  font-size: 22rpx;
  color: #bbb;
}

/* 试卷列表 */
.paper-list {
  margin: 0;
}

.paper-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
}

.paper-item:active {
  background: #f9f9f9;
}

.paper-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.paper-type-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.paper-item-info {
  display: flex;
  flex-direction: column;
}

.paper-item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.paper-item-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.paper-item-arrow {
  color: #ddd;
  font-size: 24rpx;
  margin-left: 16rpx;
}

/* 折叠面板 */
.index-collapse {
  font-size: 14px;
  line-height: 24px;
}

.index-collapse-item {
  padding: 8px 15px !important;
  border: 0px !important;
}

.index-cell {
  padding: 5px 15px !important;
}

p {
  display: none;
}