/* pages/record/index.wxss */

.record-page {
  padding-bottom: 20rpx;
}

/* 统计卡片 */
.record-stats {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 记录列表 */
.record-list {
  padding: 0 24rpx;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.record-card:active {
  background: #fafafa;
}

.record-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-paper-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.record-card-body {
  margin-bottom: 12rpx;
}

.record-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}

.record-info-label {
  font-size: 24rpx;
  color: #bbb;
}

.record-info-value {
  font-size: 24rpx;
  color: #666;
}

.record-score {
  color: #4A90E2;
  font-weight: 600;
}

.record-card-footer {
  text-align: right;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.record-action-btn {
  font-size: 24rpx;
  color: #4A90E2;
}