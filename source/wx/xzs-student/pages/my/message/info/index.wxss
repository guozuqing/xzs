/* pages/my/message/info/index.wxss */

.msg-detail-page {
  padding-bottom: 40rpx;
}

.msg-detail-card {
  padding: 36rpx 30rpx;
}

.msg-detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.msg-detail-meta {
  margin-bottom: 24rpx;
}

.msg-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.msg-meta-label {
  font-size: 26rpx;
  color: #bbb;
}

.msg-meta-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.msg-detail-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.msg-detail-body {
  padding-top: 16rpx;
}

.msg-detail-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}
