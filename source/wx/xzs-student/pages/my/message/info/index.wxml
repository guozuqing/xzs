<view class="msg-detail-page">
  <view class="msg-detail-card card">
    <text class="msg-detail-title">{{message.title}}</text>
    <view class="msg-detail-meta">
      <view class="msg-meta-row">
        <text class="msg-meta-label">发送人</text>
        <text class="msg-meta-value">{{message.sendUserName}}</text>
      </view>
      <view class="msg-meta-row">
        <text class="msg-meta-label">发送时间</text>
        <text class="msg-meta-value">{{message.createTime}}</text>
      </view>
    </view>
    <view class="msg-detail-divider"></view>
    <view class="msg-detail-body">
      <text class="msg-detail-content">{{message.content}}</text>
    </view>
  </view>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>