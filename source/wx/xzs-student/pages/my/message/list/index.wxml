<wxs module="enumItem" src="../../../../wxs/enumItem.wxs"></wxs>
<view class="msg-list-page">
  <view class="card msg-header-card">
    <text class="msg-header-title">消息中心</text>
    <text class="msg-header-count" wx:if="{{tableData.length > 0}}">共 {{total}} 条消息</text>
  </view>

  <view class="msg-list">
    <view class="msg-card" wx:for="{{tableData}}" wx:key="{{item.id}}" bindtap="goDetail" data-id="{{item.id}}">
      <view class="msg-card-header">
        <text class="msg-card-title">{{item.title}}</text>
        <view class="tag {{item.readed ? 'tag-info' : 'tag-danger'}}">
          {{enumItem.format(enumItem.state.user.message.readText, item.readed)}}
        </view>
      </view>
      <text class="msg-card-content">{{item.content}}</text>
      <view class="msg-card-footer">
        <text class="msg-card-action">查看详情 ></text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{!spinShow && tableData.length === 0}}">
    <view class="empty-state">暂无消息</view>
  </view>

  <i-load-more tip="{{loadMoreTip}}" loading="{{loadMoreLoad}}" />
  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>