/* pages/question/error/index.wxss */

.error-page {
  padding-bottom: 40rpx;
}

/* 顶部 */
.error-header {
  position: relative;
  padding-bottom: 20rpx;
}

.error-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: #fff;
  border-radius: 0 0 40rpx 40rpx;
}

.error-stats-card {
  position: relative;
  margin: 24rpx;
  margin-top: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.error-stats-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.error-stats-count {
  font-size: 26rpx;
  color: #bbb;
}

/* 错题列表 */
.error-list {
  padding: 0 24rpx;
}

.error-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.error-card:active {
  background: #fafafa;
}

.error-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.error-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.error-card-body {
  margin-bottom: 16rpx;
}

.error-card-info {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.error-card-label {
  font-size: 26rpx;
  color: #bbb;
}

.error-card-value {
  font-size: 26rpx;
  color: #333;
}

.error-card-footer {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.error-card-action {
  font-size: 26rpx;
  color: #4A90E2;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.detail-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.detail-popup-show {
  transform: translateY(0);
}

.detail-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.detail-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.detail-popup-close {
  font-size: 44rpx;
  color: #bbb;
  line-height: 1;
  padding: 0 8rpx;
}

.detail-popup-body {
  padding: 24rpx 30rpx;
  flex: 1;
  overflow-y: auto;
}

.detail-question {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-option {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 20rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: #fafafa;
}

.detail-option-prefix {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
  font-weight: 500;
}

.detail-option-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.detail-section {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-section-label {
  font-size: 24rpx;
  color: #bbb;
  display: block;
  margin-bottom: 8rpx;
}

.detail-section-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.detail-answer-wrong {
  color: #f56c6c;
  font-weight: 600;
}

.detail-answer-correct {
  color: #67c23a;
  font-weight: 600;
}
