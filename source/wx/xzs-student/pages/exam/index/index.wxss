.exam-index-page {
  padding-bottom: 20rpx;
}

/* 标签栏 */
.exam-tabs-wrap {
  display: flex;
  background: #fff;
  padding: 0 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.exam-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.exam-tab-active {
  color: #333;
  font-weight: 600;
}

.exam-tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #4A90E2;
  border-radius: 2rpx;
}

/* 试卷列表 */
.exam-list-wrap {
  padding: 16rpx 24rpx;
}

.exam-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.exam-card:active {
  background: #fafafa;
}

.exam-card-left {
  margin-right: 20rpx;
}

.exam-card-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-card-icon-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.exam-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.exam-card-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.exam-card-subject {
  font-size: 22rpx;
  color: #bbb;
}

.exam-card-right {
  margin-left: 16rpx;
}

.exam-card-btn {
  font-size: 24rpx;
  color: #4A90E2;
  background: rgba(74, 144, 226, 0.08);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  white-space: nowrap;
}

.xzs-load-more {
  margin-top: 20rpx !important;
}