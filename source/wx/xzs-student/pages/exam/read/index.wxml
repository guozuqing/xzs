<wxs module="filter" src="../../../wxs/exam-fun.wxs"></wxs>
<view class="read-page">
  <!-- 成绩概览 -->
  <view class="read-summary">
    <view class="read-summary-bg"></view>
    <view class="read-summary-card">
      <text class="read-paper-name">{{paper.name}}</text>
      <view class="read-score-row">
        <view class="read-score-item">
          <text class="read-score-num">{{answer.score}}</text>
          <text class="read-score-label">得分</text>
        </view>
        <view class="read-score-divider"></view>
        <view class="read-score-item">
          <text class="read-score-num read-score-time">{{answer.doTime}}秒</text>
          <text class="read-score-label">耗时</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 题目分组 -->
  <view class="question-section" wx:for="{{paper.titleItems}}" wx:for-item="titleItem" wx:key="{{titleItem.name}}">
    <view class="question-section-header">
      <view class="question-section-bar"></view>
      <text class="question-section-title">{{titleItem.name}}</text>
    </view>

    <view class="question-card" wx:for="{{titleItem.questionItems}}" wx:key="{{titleItem.id}}" wx:for-item="questionItem">
      <!-- 单选题 -->
      <view wx:if="{{questionItem.questionType === 1}}">
        <view class="question-title-wrap">
          <text class="question-order">{{questionItem.itemOrder}}</text>
          <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
        </view>
        <radio-group class="radio-group">
          <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item {{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content ? 'option-selected' : ''}}">
            <radio color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content}}" class="option-radio" />
            <text class="option-prefix">{{radioItem.prefix}}.</text>
            <rich-text nodes="{{radioItem.content}}" class="option-content" />
          </label>
        </radio-group>
      </view>
      <!-- 多选题 -->
      <view wx:elif="{{questionItem.questionType === 2}}">
        <view class="question-title-wrap">
          <text class="question-order">{{questionItem.itemOrder}}</text>
          <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
          <text class="question-type-tag tag-multi">多选</text>
        </view>
        <checkbox-group>
          <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item {{filter.indexOf(answer.answerItems[questionItem.itemOrder-1].content,radioItem.prefix) ? 'option-selected' : ''}}">
            <checkbox color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{filter.indexOf(answer.answerItems[questionItem.itemOrder-1].content,radioItem.prefix)}}" class="option-radio" />
            <text class="option-prefix">{{radioItem.prefix}}.</text>
            <rich-text nodes="{{radioItem.content}}" class="option-content" />
          </label>
        </checkbox-group>
      </view>
      <!-- 判断题 -->
      <view wx:elif="{{questionItem.questionType === 3}}">
        <view class="question-title-wrap">
          <text class="question-order">{{questionItem.itemOrder}}</text>
          <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
        </view>
        <radio-group class="radio-group">
          <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item {{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content ? 'option-selected' : ''}}">
            <radio color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content}}" class="option-radio" />
            <rich-text nodes="{{radioItem.content}}" class="option-content" />
          </label>
        </radio-group>
      </view>
      <!-- 填空题 -->
      <view wx:elif="{{questionItem.questionType === 4}}">
        <view class="question-title-wrap">
          <text class="question-order">{{questionItem.itemOrder}}</text>
          <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
        </view>
        <view class="fill-blank-item" wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="inputItem" wx:for-index="idx">
          <text class="fill-blank-label">{{inputItem.prefix}}</text>
          <input class="fill-blank-input" maxlength="-1" value="{{answer.contentArray[inputItem.prefix-1]}}" disabled />
        </view>
      </view>
      <!-- 简答题 -->
      <view wx:else>
        <view class="question-title-wrap">
          <text class="question-order">{{questionItem.itemOrder}}</text>
          <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
        </view>
        <view class="short-answer-wrap">
          <textarea class="short-answer-input" maxlength="-1" disabled>{{answer.answerItems[questionItem.itemOrder-1].content}}</textarea>
        </view>
      </view>

      <!-- 答题结果区域 -->
      <view class="answer-result-area">
        <view class="answer-result-header">
          <text class="answer-result-tag tag-success" wx:if="{{answer.answerItems[questionItem.itemOrder-1].doRight==true}}">正确</text>
          <text class="answer-result-tag tag-danger" wx:elif="{{answer.answerItems[questionItem.itemOrder-1].doRight==false}}">错误</text>
          <text class="answer-result-tag tag-warning" wx:elif="{{answer.answerItems[questionItem.itemOrder-1].doRight===null}}">待批改</text>
          <text class="answer-score-text">得分: {{answer.answerItems[questionItem.itemOrder-1].score}} / {{questionItem.score}}</text>
        </view>
        <view class="answer-detail-row">
          <text class="answer-detail-label">难度</text>
          <i-rate value="{{questionItem.difficult}}" i-class="answer-rate" />
        </view>
        <view class="answer-detail-row">
          <text class="answer-detail-label">解析</text>
          <rich-text nodes="{{questionItem.analyze}}" class="answer-detail-value" />
        </view>
        <view class="answer-detail-row">
          <text class="answer-detail-label">正确答案</text>
          <rich-text nodes="{{questionItem.correct}}" class="answer-detail-value answer-correct-text" wx:if="{{questionItem.questionType==1||questionItem.questionType==2||questionItem.questionType==5}}" />
          <rich-text nodes="{{filter.trueFalseFormatter(questionItem)}}" class="answer-detail-value answer-correct-text" wx:elif="{{questionItem.questionType==3}}" />
          <rich-text nodes="{{questionItem.correctArray}}" class="answer-detail-value answer-correct-text" wx:elif="{{questionItem.questionType==4}}" />
        </view>
      </view>
    </view>
  </view>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>