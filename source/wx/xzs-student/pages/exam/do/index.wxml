<view class="exam-page">
  <!-- 倒计时顶栏 -->
  <view class="countdown-bar">
    <view class="countdown-inner">
      <text class="countdown-icon">⏱</text>
      <text class="countdown-text">{{remainTimeStr}}</text>
    </view>
  </view>
  <view class="countdown-placeholder"></view>

  <!-- 试卷名称 -->
  <view class="exam-name-card">
    <text class="exam-name-text">{{form.name}}</text>
  </view>

  <form bindsubmit='formSubmit'>
    <!-- 题目分组 -->
    <view class="question-section" wx:for="{{form.titleItems}}" wx:for-item="titleItem" wx:key="{{titleItem.name}}">
      <view class="question-section-header">
        <view class="question-section-bar"></view>
        <text class="question-section-title">{{titleItem.name}}</text>
      </view>

      <view class="question-card" wx:for="{{titleItem.questionItems}}" wx:key="{{titleItem.id}}" wx:for-item="questionItem">
        <!-- 单选题 -->
        <view wx:if="{{questionItem.questionType === 1}}">
          <view class="question-title-wrap">
            <text class="question-order">{{questionItem.itemOrder}}</text>
            <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
          </view>
          <radio-group class="radio-group" name="{{questionItem.itemOrder}}_{{questionItem.id}}_{{questionItem.questionType}}">
            <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item">
              <radio color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{radioItem.checked}}" class="option-radio" />
              <text class="option-prefix">{{radioItem.prefix}}.</text>
              <rich-text nodes="{{radioItem.content}}" class="option-content" />
            </label>
          </radio-group>
        </view>
        <!-- 多选题 -->
        <view wx:elif="{{questionItem.questionType === 2}}">
          <view class="question-title-wrap">
            <text class="question-order">{{questionItem.itemOrder}}</text>
            <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
            <text class="question-type-tag tag-multi">多选</text>
          </view>
          <checkbox-group name="{{questionItem.itemOrder}}_{{questionItem.id}}_{{questionItem.questionType}}">
            <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item">
              <checkbox color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{radioItem.checked}}" class="option-radio" />
              <text class="option-prefix">{{radioItem.prefix}}.</text>
              <rich-text nodes="{{radioItem.content}}" class="option-content" />
            </label>
          </checkbox-group>
        </view>
        <!-- 判断题 -->
        <view wx:elif="{{questionItem.questionType === 3}}">
          <view class="question-title-wrap">
            <text class="question-order">{{questionItem.itemOrder}}</text>
            <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
          </view>
          <radio-group class="radio-group" name="{{questionItem.itemOrder}}_{{questionItem.id}}_{{questionItem.questionType}}">
            <label wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="radioItem" class="option-item">
              <radio color="#2c5f8a" value="{{radioItem.prefix}}" checked="{{radioItem.checked}}" class="option-radio" />
              <rich-text nodes="{{radioItem.content}}" class="option-content" />
            </label>
          </radio-group>
        </view>
        <!-- 填空题 -->
        <view wx:elif="{{questionItem.questionType === 4}}">
          <view class="question-title-wrap">
            <text class="question-order">{{questionItem.itemOrder}}</text>
            <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
          </view>
          <view class="fill-blank-item" wx:for="{{questionItem.items}}" wx:key="{{questionItem.prefix}}" wx:for-item="inputItem" wx:for-index="idx">
            <text class="fill-blank-label">{{inputItem.prefix}}</text>
            <input class="fill-blank-input" maxlength="-1" name="{{questionItem.itemOrder}}_{{questionItem.id}}_{{questionItem.questionType}}_{{idx}}" placeholder="请填写答案" />
          </view>
        </view>
        <!-- 简答题 -->
        <view wx:else>
          <view class="question-title-wrap">
            <text class="question-order">{{questionItem.itemOrder}}</text>
            <rich-text nodes="{{questionItem.title}}" class="question-title-text" />
          </view>
          <view class="short-answer-wrap">
            <textarea class="short-answer-input" placeholder="请输入答案" maxlength="-1" name="{{questionItem.itemOrder}}_{{questionItem.id}}_{{questionItem.questionType}}"></textarea>
          </view>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-wrap">
      <button class="btn-primary" form-type='submit'>提交试卷</button>
    </view>

    <!-- 超时弹窗 -->
    <i-action-sheet visible="{{timeOutShow}}" mask-closable="{{ false }}">
      <view slot="header" style="padding: 16px">
        <view class="timeout-title">考试时间结束，请提交试卷！</view>
        <button class="btn-primary" style="margin:20rpx 0" form-type='submit'>立即提交</button>
      </view>
    </i-action-sheet>
  </form>

  <!-- 结果弹窗 -->
  <i-modal title="考试结果" visible="{{modalShow}}" bind:ok="returnRecord" bind:cancel="returnRecord">
    <view class="result-modal">
      <text class="result-score">{{result}}</text>
      <text class="result-label">得分</text>
    </view>
  </i-modal>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>