.exam-page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 倒计时顶栏 */
.countdown-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.countdown-inner {
  display: flex;
  align-items: center;
}

.countdown-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.countdown-text {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.countdown-placeholder {
  height: 80rpx;
}

/* 试卷名称 */
.exam-name-card {
  text-align: center;
  padding: 24rpx 30rpx;
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.exam-name-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 题目分组 */
.question-section {
  margin: 20rpx 24rpx;
}

.question-section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.question-section-bar {
  width: 8rpx;
  height: 32rpx;
  background: #4A90E2;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.question-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A90E2;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 题目标题 */
.question-title-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.question-order {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  min-width: 44rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.question-title-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.question-type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  white-space: nowrap;
  margin-top: 6rpx;
}

.tag-multi {
  background: #fdf6ec;
  color: #e6a23c;
}

/* 选项 */
.option-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: #fafafa;
}

.option-item:active {
  background: #f5f5f5;
}

.option-radio {
  margin-right: 8rpx;
  margin-top: 4rpx;
}

.option-prefix {
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
  font-weight: 500;
}

.option-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 填空题 */
.fill-blank-item {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fafafa;
}

.fill-blank-label {
  padding: 0 24rpx;
  color: #4A90E2;
  font-weight: 600;
  font-size: 28rpx;
  background: #f5f5f5;
  line-height: 80rpx;
  min-width: 60rpx;
  text-align: center;
}

.fill-blank-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 简答题 */
.short-answer-wrap {
  margin-top: 8rpx;
}

.short-answer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-wrap {
  padding: 20rpx 0 40rpx;
}

/* 超时弹窗 */
.timeout-title {
  font-size: 32rpx;
  color: #f56c6c;
  text-align: center;
  font-weight: 600;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

/* 结果弹窗 */
.result-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.result-score {
  font-size: 64rpx;
  font-weight: 700;
  color: #4A90E2;
}

.result-label {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 8rpx;
}
