/* pages/video/detail/index.wxss */

.video-detail-page {
  padding-bottom: 40rpx;
}

/* 视频播放器 */
.video-player-wrap {
  width: 100%;
  background: #000;
}

.video-player {
  width: 100%;
  height: 420rpx;
}

.video-player-empty {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a1a;
}

.video-player-empty-text {
  color: #666;
  font-size: 28rpx;
}

/* 卡片 */
.card {
  margin: 20rpx 24rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 视频信息 */
.video-info {
  display: flex;
  flex-direction: column;
}

.video-info-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.video-info-subject {
  font-size: 24rpx;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.video-info-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 章节区块 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-bar {
  width: 6rpx;
  height: 28rpx;
  background: #4A90E2;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.section-count {
  font-size: 22rpx;
  color: #bbb;
}

/* 章节列表 */
.chapter-list {
  margin: 0;
}

.chapter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
}

.chapter-item:active {
  background: #f9f9f9;
}

.chapter-item-active {
  background: rgba(74, 144, 226, 0.06);
}

.chapter-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.chapter-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.chapter-index-active {
  background: #4A90E2;
  color: #fff;
}

.chapter-item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.chapter-item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.chapter-item-duration {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.chapter-playing {
  font-size: 22rpx;
  color: #4A90E2;
  font-weight: 500;
}

.chapter-item-arrow {
  color: #ddd;
  font-size: 20rpx;
  margin-left: 16rpx;
}
