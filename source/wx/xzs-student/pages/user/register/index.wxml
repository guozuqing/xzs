<wxs module="enumItem" src="../../../wxs/enumItem.wxs"></wxs>
<view class="register-page">
  <!-- 顶部banner -->
  <view class="register-banner">
    <image src="/assets/banner-bg.png" class="register-banner-img" mode="aspectFill"></image>
    <view class="register-banner-overlay"></view>
  </view>

  <!-- 表单卡片 -->
  <view class="register-card-wrap">
    <view class="register-card">
      <image src="/assets/sky-logo.png" class="register-logo" mode="aspectFit"></image>
      <text class="register-subtitle">注册新账号</text>

      <form bindsubmit='formSubmit'>
        <view class="register-field">
          <view class="register-field-icon"><text class="field-icon-text">👤</text></view>
          <input class="register-field-input" name="userName" value="{{userName}}" placeholder="请输入用户名" maxlength="-1" />
        </view>

        <view class="register-field">
          <view class="register-field-icon"><text class="field-icon-text">🔒</text></view>
          <input class="register-field-input" name="password" value="{{password}}" placeholder="请输入密码" password="true" maxlength="-1" />
        </view>

        <view class="register-field">
          <view class="register-field-icon"><text class="field-icon-text">🎓</text></view>
          <picker mode="selector" range="{{ enumItem.state.user.levelEnum }}" range-key="{{'value'}}" value="{{levelIndex}}" bindchange="bindLevelChange" class="register-picker-wrap">
            <view class="register-picker-inner">
              <text class="register-picker-text">{{ enumItem.state.user.levelEnum[levelIndex].value }}</text>
              <text class="register-picker-arrow">›</text>
            </view>
            <input value="{{enumItem.state.user.levelEnum[levelIndex].key}}" maxlength="-1" name="userLevel" class="exam-hidden" />
          </picker>
        </view>

        <button class="register-btn" form-type='submit'>注 册</button>
      </form>

      <view class="register-footer">
        <text class="register-footer-text">已有账号? <text bindtap="goLogin" class="register-login-link">去登录</text></text>
      </view>
    </view>
  </view>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>