<!--pages/user/bind/index.wxml-->
<view class="login-page">
  <!-- 顶部banner图 -->
  <view class="login-banner">
    <image src="/assets/banner-bg.png" class="login-banner-img" mode="aspectFill"></image>
    <view class="login-banner-overlay"></view>
  </view>

  <!-- 表单卡片 (上移覆盖banner底部) -->
  <view class="login-card-wrap">
    <view class="login-card">
      <image src="/assets/sky-logo.png" class="login-logo" mode="aspectFit"></image>
      <text class="login-subtitle">培训发展部考试系统</text>

      <form bindsubmit='formSubmit'>
        <view class="login-field">
          <view class="login-field-icon">
            <text class="field-icon-text">👤</text>
          </view>
          <input class="login-field-input" name="userName" value="{{userName}}" placeholder="请输入用户名" maxlength="-1" />
        </view>

        <view class="login-field">
          <view class="login-field-icon">
            <text class="field-icon-text">🔒</text>
          </view>
          <input class="login-field-input" name="password" value="{{password}}" placeholder="请输入密码" password="true" maxlength="-1" />
        </view>

        <button class="login-btn" form-type='submit'>登 录</button>
      </form>

      <view class="login-footer">
        <text class="login-footer-text">没有账号? <text bindtap="register" class="login-register-link">马上注册</text></text>
      </view>
    </view>

    <view class="login-copyright">
      <text class="login-copyright-text">Copyright © 2019-2026 天空领域培训发展部 版权所有</text>
    </view>
  </view>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>
