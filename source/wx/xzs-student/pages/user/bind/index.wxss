/* pages/user/bind/index.wxss */

.login-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部banner */
.login-banner {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.login-banner-img {
  width: 100%;
  height: 100%;
}

.login-banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(to bottom, transparent, rgba(245, 245, 245, 0.5) 50%, #f5f5f5 100%);
}

/* 表单卡片区域 */
.login-card-wrap {
  position: relative;
  margin-top: -120rpx;
  padding: 0 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  padding: 52rpx 48rpx 44rpx;
  box-shadow: 0 8rpx 60rpx rgba(0, 0, 0, 0.08), 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(20px);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  width: 320rpx;
  height: 68rpx;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 24rpx;
  color: #a0aec0;
  letter-spacing: 3rpx;
  margin-bottom: 44rpx;
}

/* 输入框 */
.login-field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 92rpx;
  background: #f7f8fc;
  border: 2rpx solid #eff1f5;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.login-field-icon {
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}

.field-icon-text {
  font-size: 28rpx;
  opacity: 0.6;
}

.login-field-input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
  color: #2d3748;
  padding-left: 4rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100% !important;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 14rpx;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5ba3f0 100%) !important;
  color: #fff !important;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(74, 144, 226, 0.3);
}

.login-btn::after {
  border: none;
}

/* 底部 */
.login-footer {
  margin-top: 28rpx;
  text-align: center;
}

.login-footer-text {
  font-size: 24rpx;
  color: #a0aec0;
}

.login-register-link {
  color: #4A90E2;
  font-weight: 600;
}

/* 版权 */
.login-copyright {
  margin-top: 44rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

.login-copyright-text {
  font-size: 20rpx;
  color: #b8c4d4;
}
